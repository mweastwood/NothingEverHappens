rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is signed in and matches the userId
    function isUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User Profile: Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if isUser(userId);

      // Private Tasks: Users can read/write their own tasks
      match /tasks/{taskId} {
        allow read, write: if isUser(userId);
      }

      // History: Users can read/write their own history/deltas
      match /history/{deltaId} {
        allow read, write: if isUser(userId);
      }
    }
  }
}
