rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is signed in and matches the userId
    function isUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper to check if two users share the same familyId
    function areInSameFamily(userId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId == get(/databases/$(database)/documents/users/$(userId)).data.familyId;
    }

    // Helper to check if user is a parent in a family
    function isParentOfFamily(familyId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid].role == 'parent';
    }

    // User Profile: Users can read/write their own profile, and family members can read
    match /users/{userId} {
      allow read: if isUser(userId) || areInSameFamily(userId);
      allow write: if isUser(userId);

      // Private Tasks: Users can read/write their own tasks, and family members can read
      match /tasks/{taskId} {
        allow read: if isUser(userId) || areInSameFamily(userId);
        allow write: if isUser(userId);
      }

      // History: Users can read/write their own history/deltas
      match /history/{deltaId} {
        allow read, write: if isUser(userId);
      }

      // Settings: Users can read/write their own settings, and family members can read
      match /settings/{settingsId} {
        allow read: if isUser(userId) || areInSameFamily(userId);
        allow write: if isUser(userId);
      }
    }

    // Families: Users can read if they are members. Any authenticated user can create.
    // Existing members can update, or joining members can add themselves.
    match /families/{familyId} {
      allow read: if request.auth != null && (
        resource == null || resource.data.members[request.auth.uid] != null
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        // Existing member
        resource.data.members[request.auth.uid] != null
        ||
        // Joining user adding themselves
        (request.resource.data.members[request.auth.uid] != null && resource.data.members[request.auth.uid] == null)
      );

      // Helper function to check if user is a member of the family
      function isFamilyMember() {
        return request.auth != null && resource == null || (
          get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid] != null
        );
      }

      // Helper function to check if user is a parent in the family
      function isFamilyParent() {
        return request.auth != null && (
          get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid].role == 'parent'
        );
      }

      // Family-scoped Tasks
      match /tasks/{taskId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid] != null
        );
        allow create: if request.auth != null && (
          get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid].role == 'parent'
        );
        allow delete: if request.auth != null && (
          get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid].role == 'parent'
          ||
          (get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid] != null && resource.data.schedule.type == 'oneOff')
        );
        allow update: if request.auth != null && (
          get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid].role == 'parent'
          ||
          (
            get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid] != null
            &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'title', 'description', 'estimatedDuration', 'priority', 'isFamily', 'missedPolicy', 'isMaster', 'dailyTimes', 'cycleId'
            ])
          )
        );
      }

      // Family-scoped History / Deltas
      match /history/{deltaId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid] != null
        );
        allow create: if request.auth != null && (
          get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid] != null
        );
        allow update, delete: if false; // Append-only
      }
    }

    // Invites: users can read/write if they are sender or recipient, or if they are a parent in the family
    match /invites/{inviteId} {
      allow read: if request.auth != null && (
        resource.data.toEmail == request.auth.token.email
        ||
        resource.data.fromEmail == request.auth.token.email
        ||
        isParentOfFamily(resource.data.familyId)
      );
      allow create: if request.auth != null && (
        request.resource.data.fromEmail == request.auth.token.email
        &&
        isParentOfFamily(request.resource.data.familyId)
      );
      allow update, delete: if request.auth != null && (
        // Recipient can update status or delete
        resource.data.toEmail == request.auth.token.email
        ||
        // Sender can cancel
        resource.data.fromEmail == request.auth.token.email
        ||
        // Any parent in the family can revoke
        isParentOfFamily(resource.data.familyId)
      );
    }
  }
}
